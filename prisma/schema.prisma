datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Incident {
  id        Int      @id @default(autoincrement())
  title     String
  service   String
  severity  String
  status    String
  owner     String?
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
